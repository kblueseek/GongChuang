<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypen="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vision_node</name>
  <version>0.1.0</version>
  <description>统一视觉节点：单摄像头、多业务（color_pick / vision_put / calibrate），业务按注册表挂载</description>
  <maintainer email="kblueseek@users.noreply.github.com">kblue</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>car_interfaces</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
