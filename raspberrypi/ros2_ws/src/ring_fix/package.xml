<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypen="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ring_fix</name>
  <version>0.1.0</version>
  <description>圆环工位视觉对位：识别三圆环，小步驱动底盘把中间环对到标定基准，收敛后通过 /set_odom 重置里程计</description>
  <maintainer email="kblueseek@users.noreply.github.com">kblue</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>car_interfaces</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
