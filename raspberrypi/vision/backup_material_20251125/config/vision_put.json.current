{
  "_comment": "vision_put 的现场标定值。命令行走参数时以命令行为准，这里只做默认值。上位机『视觉对环 PID』页直接读写这份文件。",
  "_target": "夹爪正对环心时，环心在画面上的像素坐标。用 --dry-run 摆正后读出来填。",
  "target_x": 685.0,
  "target_y": 493.0,
  "_roi": "保留中间区域：左右/上下分别裁掉多少比例（0=不裁）。默认左右各 0.175 → 中间 65% 宽、整幅高。旧 roi_fraction 仅在新参数全 0 时生效，默认 1.0 关闭。",
  "roi_left_crop": 0.0,
  "roi_right_crop": 0.0,
  "roi_top_crop": 0.0,
  "roi_bottom_crop": 0.0,
  "roi_fraction": 1.0,
  "_detect_roi": "检测 ROI 半径（像素）：以目标像素/上一帧锁定的环心为中心，只在这个范围内找环；0=全图。缩小搜索面积能明显提高检测帧率，也减少远处杂边误判。环离目标超过这个距离就设大或设 0。",
  "detect_roi_margin_px": 250.0,
  "_use_predicted_layout": "false=只用当前帧真实观测到的环心（队友原版行为，单环不会凭空多出 P1/P2/P3）；true=启用三环布局预测，环被物料挡住时用，但单环场景会画出/锁到虚拟环。",
  "use_predicted_layout": false,
  "_ring": "0 = 取离目标像素最近的环；1/2/3 = 左/中/右",
  "ring": 0,
  "_lock": "选定最近的那个环后只跟它：新观测离上次环心超过这个像素数就当作该环丢失，原地等，不会切到旁边的环",
  "lock_radius_px": 150.0,
  "_max_target_distance": "第一次选环时环心离目标像素的最大允许距离；画面里其他工位的环/物料离得太远，误锁会直接跑偏",
  "max_target_distance_px": 300.0,
  "_pid": "默认值和 color_pick 的 track_pid.json 一致（同一套相机/云台，方向已实车验证）",
  "kp_yaw": 1.74,
  "ki_yaw": 0.02,
  "kd_yaw": 0.0,
  "kp_extend": 6.07,
  "ki_extend": 0.03,
  "kd_extend": 0.0,
  "max_yaw_deg_s": 780.0,
  "max_extend_deg_s": 1155.0,
  "deriv_tau": 0.05,
  "_sign": "和 color_pick 一致，不用再改",
  "yaw_sign": -1.0,
  "ext_sign": -1.0,
  "_tol": "deadband 是控制死区，tol 是判定成功的容差（像素）",
  "deadband_px": 8.0,
  "tol_px": 10.0,
  "stable": 6.0,
  "_settle": "角度多久不变就算『臂已到位』，随后立刻开始对环；设 0 = 不检查",
  "settle_stable_s": 0.2,
  "_timeout": "整段超时（含等待停稳）",
  "timeout": 30.0
