{
  "_comment": "calibrate 业务（vision_node）的现场参数。上位机『视觉矫正 PID』页直接读写这份文件；vision_node/businesses/calibrate.py 每次开始前读它。动作序列的 calibrate args 里写了同名项时以序列为准。",
  "_offset": "对准后 车体里程计坐标 − 圆环里程计坐标（米）。默认 0 = 对准位置就是圆环坐标。",
  "align_offset_x_m": 0.0,
  "align_offset_y_m": 0.0,
  "_align_yaw": "对准后车体航向（度）。留空 = 只修位置、不修航向。GUI 面板不提供滑杆，直接改这里。",
  "align_yaw_deg": "",
  "_target": "中间圆环要对到的画面像素。不写/空 = 用 ring_station_detector.json 的参考环心（当前 633.5, 321.6），不是画面中心(640,360)。上位机『视觉矫正 PID』页可拖。",
  "target_x": 595.0,
  "target_y": 348.0,
  "_cam_rotation": "calibrate 自己的画面旋转角：空/不写 = 跟随 vision_node 的 cam_rotation。旧标定是在摄像头倒装时做的（当时 calibrate 不转图，看的是原始倒像）；摄像头物理转正、color_pick 改成 0 后，参考环心/纠偏矩阵还是倒像那套，所以 calibrate 单独填 180。若方向仍反，改回 0。",
  "cam_rotation": 180,
  "_pid": "底盘对位 PID：输入是视觉纠偏量（mm/mm/°），输出是速度（mm/s、°/s），再按 lead=v/chassis_pos_kp 换算成 /cmd_pose 领先量。外环等效单步增益≈ctrl_kp_xy/chassis_pos_kp。当前 1.2/1.74≈0.69：classic 只有 ~12Hz，1.39（0.8）会冲过头，1.0 又偏慢；1.2 是折中。ki/kd 归零：稳态误差来自轮速整数RPM量化，不是积分不够。",
  "ctrl_kp_xy": 1.2,
  "ctrl_ki_xy": 0.0,
  "ctrl_kd_xy": 0.0,
  "ctrl_kp_yaw": 1.72,
  "ctrl_ki_yaw": 0.0,
  "ctrl_kd_yaw": 0.0,
  "_limits": "PID 输出限幅：平移 m/s、转向 °/s。0.10m/s 即 1RPM≈4.08mm/s 的 24 倍，够快又不至于对位时冲过头。",
  "max_xy_speed_m_s": 0.1,
  "max_yaw_speed_deg_s": 20.0,
  "_min_speed": "最小速度：F407 轮速是整数RPM（1RPM≈4.08mm/s），低于0.5RPM会被舍成0。只在误差>2倍死区时给这一脚；末端误差进入死区附近不再补速度，否则会冲过头来回抖。",
  "min_xy_speed_m_s": 0.004,
  "min_yaw_speed_deg_s": 1.0,
  "_deadband": "误差小于死区就不再输出，避免原地抖。死区必须大于视觉噪声（实测±0.5~1mm），否则PID会去追噪声。",
  "ctrl_deadband_xy_mm": 1.0,
  "ctrl_deadband_yaw_deg": 0.5,
  "_filter": "微分低通 / 视觉误差一阶低通（秒）。12Hz 检测下 0.08 的滞后会让 1.39 的 kp 冲过头；0.06 配合 kp=1.2，兼顾速度和平滑。",
  "ctrl_deriv_tau": 0.05,
  "ctrl_filter_tau": 0.06,
  "_hysteresis": "滞环：误差进到 stop 以内就完全停车并保持位姿；超过 converge_tol 才重新起步。stop 取 1.8mm：v=2mm/s 会被舍成0，2.1mm/s 就跳到4mm/s，1.4 正好卡在台阶下面会来回磨，停在 1.8 既在验收 2mm 内又能真的停住。",
  "ctrl_stop_xy_mm": 1.8,
  "ctrl_stop_yaw_deg": 0.6,
  "ctrl_settle_s": 0.15,
  "_lead": "位置/航向环 Kp 正常运行时自动跟随 F407 调参页（/tune_state 的 0x05/0x08），这里只是没收到回传时的兜底值，应和 F407 上电默认一致。不在上位机面板里重复调。",
  "chassis_pos_kp": 1.74,
  "chassis_heading_kp": 2.15,
  "_lead_limit": "单拍位姿领先量上限，防止参数异常时目标飞出去。注意实际还受 max_xy_speed_m_s 限制：lead ≤ max_speed/chassis_pos_kp = 57mm。想一步走更远就抬 max_xy_speed（或改成直接按误差给领先量）。",
  "max_lead_xy_mm": 100.0,
  "max_lead_yaw_deg": 10.0,
  "_converge": "连续 hold 帧满足 tol 才算对准；超时则这条 calibrate 失败跳过。旧版是 6 帧，但 12Hz 下 6 帧=0.5s 白等；稳定窗口已缩到 3 帧，hold 同步降到 4。",
  "converge_tol_xy_mm": 2.0,
  "converge_tol_yaw_deg": 0.6,
  "converge_hold_frames": 4.0,
  "timeout_s": 45.0,
  "_quality": "false/0 = 三个环稳定可见就开始纠偏；true/1 = 额外要求置信度/残差/透视比达标。",
  "require_quality": false
}