+        max(2, int(radius_min)), max(3, int(radius_max)) + 1
+    )
+    hits = np.zeros(len(radii), dtype=np.float64)
+    for index, radius in enumerate(radii):
+        xs = np.rint(center[0] + radius * cosines).astype(np.int64)
+        ys = np.rint(center[1] + radius * sines).astype(np.int64)
+        inside = (xs >= 0) & (xs < width) & (ys >= 0) & (ys < height)
+        if int(np.count_nonzero(inside)) < samples * 0.5:
+            continue
