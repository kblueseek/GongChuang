+def _radial_ring_profile(edges, center, radius_min, radius_max,
+                         samples=180):
+    """从圆心沿径向扫描，返回 (radii, hits)：每个半径上"边缘命中率"。
+
+    这是判断"是不是真的多圈同心环"的独立判据，和轮廓法完全解耦：
+    虚线圈在它自己的半径上，射线打过去有 50%~75% 会碰到虚线段（断口处落空），
+    而物料/杂点在半径方向只有一两个位置有边缘。
+    用它可以精确数出"几圈"，比 diameter_bands 那种靠直径差分的估计可靠得多。
+    """
