--cpu Cortex-M3
"chassiscontrol\startup_stm32f103xb.o"
"chassiscontrol\main.o"
"chassiscontrol\gpio.o"
"chassiscontrol\can.o"
"chassiscontrol\tim.o"
"chassiscontrol\usart.o"
"chassiscontrol\stm32f1xx_it.o"
"chassiscontrol\stm32f1xx_hal_msp.o"
"chassiscontrol\stm32f1xx_hal_gpio_ex.o"
"chassiscontrol\stm32f1xx_hal_can.o"
"chassiscontrol\stm32f1xx_hal.o"
"chassiscontrol\stm32f1xx_hal_rcc.o"
"chassiscontrol\stm32f1xx_hal_rcc_ex.o"
"chassiscontrol\stm32f1xx_hal_gpio.o"
"chassiscontrol\stm32f1xx_hal_dma.o"
"chassiscontrol\stm32f1xx_hal_cortex.o"
"chassiscontrol\stm32f1xx_hal_pwr.o"
"chassiscontrol\stm32f1xx_hal_flash.o"
"chassiscontrol\stm32f1xx_hal_flash_ex.o"
"chassiscontrol\stm32f1xx_hal_exti.o"
"chassiscontrol\stm32f1xx_hal_tim.o"
"chassiscontrol\stm32f1xx_hal_tim_ex.o"
